{
	// Editor autocompletion + validation. Requires `wrangler` in devDependencies
	// (`npm i -D wrangler`) — otherwise the path is dead and this line does nothing.
	"$schema": "./node_modules/wrangler/config-schema.json",

	"name": "taras-life",
	"compatibility_date": "2026-10-23",

	// No `taras-life.<account>.workers.dev` URL, and no per-version preview URLs.
	"workers_dev": false,
	"preview_urls": false,

	// Read by Cloudflare Workers Builds (the dashboard CI) as its build step.
	// Quartz's created-modified-date plugin uses @napi-rs/simple-git, so it needs real
	// git history for accurate `modified` dates; Workers Builds checks out a shallow
	// clone, hence the unshallow. `|| true` matters: on an already-complete clone
	// `git fetch --unshallow` exits non-zero, which would abort the build.
	"build": {
		"command": "git fetch --unshallow || true; npm run build",
	},

	// Quartz emits the site into ./public (gitignored — treated as disposable output).
	"assets": {
		"directory": "./public",
	},

	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
		},
	},

	// Production route only. `custom_domain: true` has Cloudflare manage the DNS record
	// and certificate for taras.life, so there is no separate CNAME step.
	"routes": [
		{
			"pattern": "taras.life",
			"custom_domain": true,
		},
	],
}
