{
	// Editor autocompletion + validation. Requires `wrangler` in devDependencies
	// (`npm i -D wrangler`) — otherwise the path is dead and this line does nothing.
	"$schema": "./node_modules/wrangler/config-schema.json",

	"name": "taras-life",
	"compatibility_date": "2026-10-23",

	// No `taras-life.<account>.workers.dev` URL.
	"workers_dev": false,

	"preview_urls": false,
	"previews": {},
	// no "build " : { "command": "fetch shallow and/or npm run build, etc." }, because it's set in the UI for SSOT

	// Quartz emits the site into ./public (gitignored — treated as disposable output).
	"assets": {
		"directory": "./public",
		"not_found_handling": "404-page",
	},

	"observability": {
		"enabled": true,
		"logs": {
			"invocation_logs": true,
		},
	},

	// Production route only. `custom_domain: true` has Cloudflare manage the DNS record
	// and certificate for taras.life, so there is no separate CNAME step.
	"routes": [
		{
			"pattern": "taras.life",
			"custom_domain": true,
		},
	],
}
